# =============================================================================
# 1TOPS RISC-V SoC .gitignore
# =============================================================================

./*.txt 

# 1. Debugger Folder Documents, Presentations & Diagram Renders
**/debugger/*.pdf
**/debugger/*.png
**/debugger/*.svg
**/debugger/*.jpg
**/debugger/*.jpeg
**/debugger/*.docx
**/debugger/*.pptx
**/debugger/~$*
**/debugger/build_*.py
**/debugger/*ppt*.py
**/debugger/*docx*.py

# 2. Xilinx Vivado Generated Files & Directories
vivado*.log
vivado*.jou
vivado*.str
*.backup.log
*.backup.jou
.Xil/
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.dcp
*.bit
*.sysdef
*.wdb
*.wdf
xsim.dir/
xelab.log
xelab.pb
xelab*.jou
xsim*.jou
xsim*.log

# FPGA Isolated Build Directory (keep empty folder via .gitkeep)
fpga/build/*
!fpga/build/.gitkeep
fpga/vivado_project/
schematics/rv32_core_schematic/
*.xpr

# 3. RTLvision Logs
rtlvision/*.log
rtlvision/work/

# 4. Synopsys VCS Simulation Artifacts
csrc/
simv*
*.daidir/
ucli.key
vc_hdrs.h
*.vpd
*.fsdb
*.vdb
DVEfiles/
verdiLog/
novas.conf
novas.rc

# 5. QuestaSim / ModelSim / Verilator Simulation Artifacts
work/
rtl_work/
obj_dir/
transcript*
msim_transcript*
vsim.wlf
*.wlf
modelsim.ini
*.vcd

# 6. Compiler & Bare-Metal Software Build Artifacts
**/build/*
!**/build/.gitkeep
*.elf
*.hex
*.objdump
*.dump
*.o
*.a
software/*.bin
software/*.mem

# 7. Quartus Compilation & Project Outputs
output_files/
db/
incremental_db/
simulation/
*.qws
*.qdf
*.rpt
*.sof
*.pof
*.done
*.smsg
*.summary
*.jdi
*.sld
*.sta.rpt
*.sta.summary
*.map.rpt
*.map.summary
*.fit.rpt
*.fit.summary
*.flow.rpt

# 8. Synopsys SpyGlass Lint, CDC & RDC
# Ignore all internal run directories, schematic databases, caches, and dumps
spyglass/**/riscv_soc_ahb/
spyglass/**/spyglass_spysch/
spyglass/**/.SG_SaveRestoreDB/
spyglass/**/.design_setup_db/
spyglass/**/WORK/
spyglass/**/in_tool_debug_data/
spyglass/**/.tmp*
spyglass/**/smdb/
spyglass/**/nomdb/
spyglass/**/sch.vdbdir/
spyglass/**/*.vdbdir/
spyglass/**/html_reports/
spyglass/**/Run_Summary/

# SpyGlass binary databases, dumps, and intermediate artifacts
spyglass/**/*.sdb
spyglass/**/*.vdb
spyglass/**/*.vdb.data
spyglass/**/*.vdbdat
spyglass/**/*.db
spyglass/**/*.db.tmp
spyglass/**/*.bin.gz
spyglass/**/*.int
spyglass/**/*.out
spyglass/**/*.dump
spyglass/**/*.dmp
spyglass/**/*.nlv
spyglass/**/*.psd
spyglass/**/.*

# Machine/User-specific environment & local GUI logs (contains licenses, user IDs & machine paths)
spyglass/**/*.env
spyglass/**/gui_command.log
spyglass/**/dashboard.log
spyglass/**/datasheet.log
spyglass/**/html.log
spyglass/**/auto-saved-session.tcl
spyglass/**/ungroup.tcl
spyglass/**/sg_opts.tcl
spyglass/**/clom_file
spyglass/**/sg_del.pl
spyglass/**/sg_msgtag.*
spyglass/**/tag_name_id_mapping.txt
spyglass/**/NomSavedStatus

# Explicitly keep required project configuration, constraints, and consolidated sign-off proof reports
!spyglass/**/*.prj
!spyglass/**/*.sgdc
!spyglass/**/*.swl
!spyglass/**/consolidated_reports/**
!spyglass/**/consolidated_reports/**/*.rpt
!spyglass/**/consolidated_reports/**/README
!spyglass/**/consolidated_reports/**/ReportPortInfo
!spyglass/**/consolidated_reports/**/*.log

# STRICT: Machine-specific environment files must NEVER be tracked (contain paths & user IDs)
spyglass/**/*.env

# 9. Python Cache, Editors & OS Files
__pycache__/
*.py[cod]
*$py.class
*.swp
*.swo
*~
*.bak*
.DS_Store
