# =============================================================================
# 1TOPS RISC-V SoC .gitignore
# =============================================================================

./*.txt 

# 1. Debugger Folder Documents, Presentations & Diagram Renders
**/debugger/*.pdf
**/debugger/*.png
**/debugger/*.svg
**/debugger/*.jpg
**/debugger/*.jpeg
**/debugger/*.docx
**/debugger/*.pptx
**/debugger/~$*
**/debugger/build_*.py
**/debugger/*ppt*.py
**/debugger/*docx*.py

# 2. Xilinx Vivado Generated Files & Directories
vivado*.log
vivado*.jou
vivado*.str
*.backup.log
*.backup.jou
.Xil/
*.runs/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.dcp
*.bit
*.sysdef
*.wdb
*.wdf
xsim.dir/
xelab.log
xelab.pb
xelab*.jou
xsim*.jou
xsim*.log

# FPGA Isolated Build Directory (keep empty folder via .gitkeep)
fpga/build/*
!fpga/build/.gitkeep
fpga/vivado_project/
schematics/rv32_core_schematic/
*.xpr

# 3. RTLvision Logs
rtlvision/*.log
rtlvision/work/

# 4. Synopsys VCS Simulation Artifacts
csrc/
simv*
*.daidir/
ucli.key
vc_hdrs.h
*.vpd
*.fsdb
*.vdb
DVEfiles/
verdiLog/
novas.conf
novas.rc

# 5. QuestaSim / ModelSim / Verilator Simulation Artifacts
work/
rtl_work/
obj_dir/
transcript*
msim_transcript*
vsim.wlf
*.wlf
modelsim.ini
*.vcd

# 6. Compiler & Bare-Metal Software Build Artifacts
**/build/*
!**/build/.gitkeep
*.elf
*.hex
*.objdump
*.dump
*.o
*.a
software/*.bin
software/*.mem

# 7. Quartus Compilation & Project Outputs
output_files/
db/
incremental_db/
simulation/
*.qws
*.qdf
*.rpt
*.sof
*.pof
*.done
*.smsg
*.summary
*.jdi
*.sld
*.sta.rpt
*.sta.summary
*.map.rpt
*.map.summary
*.fit.rpt
*.fit.summary
*.flow.rpt

# 8. Synopsys SpyGlass Lint & CDC
# Ignore all internal databases, compiled work libraries, and caches
**/spyglass_spysch/
**/.SG_SaveRestoreDB/
**/.design_setup_db/
**/WORK/
**/in_tool_debug_data/
**/.tmp*
**/smdb/
**/nomdb/
**/*.vdbdir/

# SpyGlass binary databases, dumps, and intermediate artifacts
spyglass/**/*.sdb
spyglass/**/*.vdb
spyglass/**/*.vdb.data
spyglass/**/*.vdbdat
spyglass/**/*.db
spyglass/**/*.db.tmp
spyglass/**/*.bin.gz
spyglass/**/*.int
spyglass/**/*.out
spyglass/**/*.dump
spyglass/**/*.dmp
spyglass/**/*.nlv
spyglass/**/*.psd
spyglass/**/.*

# Machine/User-specific environment & local GUI logs (contains licenses & paths)
spyglass/**/gui_command.log
spyglass/**/dashboard.log
spyglass/**/datasheet.log
spyglass/**/html.log
spyglass/**/auto-saved-session.tcl
spyglass/**/ungroup.tcl
spyglass/**/sg_opts.tcl
spyglass/**/clom_file
spyglass/**/sg_del.pl
spyglass/**/sg_msgtag.*
spyglass/**/tag_name_id_mapping.txt
spyglass/**/NomSavedStatus

# Explicitly un-ignore required proof reports, logs, and project configurations
!spyglass/**/*.prj
!spyglass/**/consolidated_reports/**
!spyglass/**/Run_Summary/**
!spyglass/**/html_reports/**
!spyglass/**/spyglass_reports/**
!spyglass/**/*.sgdc
!spyglass/**/*.swl
!spyglass/**/*.rpt

# Re-ignore sensitive environment & machine-specific files inside report folders
spyglass/**/*.env
spyglass/**/html_reports/log/
spyglass/**/Run_Summary/.*

# 9. Python Cache, Editors & OS Files
__pycache__/
*.py[cod]
*$py.class
*.swp
*.swo
*~
*.bak*
.DS_Store
